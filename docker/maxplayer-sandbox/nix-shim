#!/bin/sh
# Every nix entry point in this image is a symlink to this script.
#
# nix honours $HOME only when the calling uid OWNS it; a $HOME owned by anyone else is discarded and
# nix falls back to getpwuid(), which has no entry for the host uid the job runs as. $HOME here is
# root-owned 0777 by construction (see the Dockerfile), so an unshimmed nix aborts with "cannot
# determine user's home directory" on every invocation. Hand it a directory under that same 0777
# parent instead: it does not exist until the job creates it, so the job owns it.
#
# Dispatch is on the invoked name, so one script serves nix, nix-build, nix-store and the rest.
set -e

if [ "$(stat -c %u "$HOME" 2>/dev/null)" != "$(id -u)" ]; then
    HOME="$HOME/nix-$(id -u)"
    mkdir -p "$HOME"
    export HOME
fi

exec "/nix/nixbin/${0##*/}" "$@"
