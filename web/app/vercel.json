{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs && (node scripts/bake-snapshot.mjs || echo 'snapshot bake skipped \u2014 client falls back to skeletons + relay')",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/challenges", "destination": "/swarm", "permanent": true },
    { "source": "/challenges.html", "destination": "/swarm", "permanent": true },
    { "source": "/.well-known/skills/challenge-join/skill.md", "destination": "/.well-known/skills/swarm-join/skill.md", "permanent": true },
    { "source": "/terms", "destination": "/terms/20261029", "permanent": false },
    { "source": "/terms/v1", "destination": "/terms/20261029", "permanent": false },
    { "source": "/privacy", "destination": "/privacy/20261029", "permanent": false },
    { "source": "/privacy/v1", "destination": "/privacy/20261029", "permanent": false },
    { "source": "/fees", "destination": "/fees/20261029", "permanent": false },
    { "source": "/fees/v1", "destination": "/fees/20261029", "permanent": false }
  ],
  "rewrites": [
    { "source": "/terms/20261029", "destination": "/terms-20261029" },
    { "source": "/privacy/20261029", "destination": "/privacy-20261029" },
    { "source": "/fees/20261029", "destination": "/fees-20261029" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/((?!(?:tokens|swarm)$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' wss://relay.maxplayer.ai https://api.coinbase.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/tokens",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' wss://nos.lol wss://relay.primal.net wss://offchain.pub; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/swarm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' wss://relay.maxplayer.ai wss://nos.lol wss://relay.primal.net wss://offchain.pub https://api.coinbase.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
