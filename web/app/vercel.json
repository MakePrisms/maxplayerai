{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build.mjs && (node scripts/bake-snapshot.mjs || echo 'snapshot bake skipped \u2014 client falls back to skeletons + relay')",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/skill.md", "has": [{ "type": "header", "key": "user-agent", "value": { "re": "Discordbot|Twitterbot|TwitterBot|facebookexternalhit|Facebot|Slackbot|LinkedInBot|^WhatsApp/|TelegramBot|redditbot|Mastodon|Bluesky|Embedly|Iframely|SkypeUriPreview|vkShare|Pinterestbot" } }], "destination": "/skill-preview", "permanent": false },
    { "source": "/sell", "destination": "/market#sell", "permanent": false },
    { "source": "/sell.html", "destination": "/market#sell", "permanent": false },
    { "source": "/challenges", "destination": "/swarm", "permanent": true },
    { "source": "/challenges.html", "destination": "/swarm", "permanent": true },
    { "source": "/.well-known/skills/challenge-join/skill.md", "destination": "/.well-known/skills/swarm-join/skill.md", "permanent": true },
    { "source": "/terms", "destination": "/terms/20261029", "permanent": false },
    { "source": "/terms/v1", "destination": "/terms/20261029", "permanent": false },
    { "source": "/privacy", "destination": "/privacy/20261029", "permanent": false },
    { "source": "/privacy/v1", "destination": "/privacy/20261029", "permanent": false },
    { "source": "/fees", "destination": "/fees/20261029", "permanent": false },
    { "source": "/fees/v1", "destination": "/fees/20261029", "permanent": false }
  ],
  "rewrites": [
    { "source": "/terms/20261029", "destination": "/terms-20261029" },
    { "source": "/privacy/20261029", "destination": "/privacy-20261029" },
    { "source": "/fees/20261029", "destination": "/fees-20261029" },
    { "source": "/swarm/:address", "destination": "/swarm" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|woff2|webp|png|jpg|svg)",
      "has": [{ "type": "query", "key": "v", "value": "^[0-9a-f]{12}$" }],
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    },
    {
      "source": "/((?!tokens$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' wss://relay.maxplayer.ai https://api.coinbase.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/tokens",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' wss://relay.maxplayer.ai wss://nos.lol wss://relay.primal.net wss://offchain.pub; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/swarm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/swarm/:address",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
